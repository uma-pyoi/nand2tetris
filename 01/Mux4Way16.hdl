// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    Not(in=sel[0], out=nsel0);
    Not(in=sel[1], out=nsel1);

    // SEL combos
    And(a=nsel0, b=nsel1, out=sel00);
    And(a=sel[0], b=nsel1, out=sel01);
    And(a=nsel0, b=sel[1], out=sel10);
    And(a=sel[0], b=sel[1], out=sel11);

    // a
    And(a=sel00, b=a[0], out=outa0); //if sel isnt 0, then out still defaults to 0
    And(a=sel00, b=a[1], out=outa1);
    And(a=sel00, b=a[2], out=outa2);
    And(a=sel00, b=a[3], out=outa3);
    And(a=sel00, b=a[4], out=outa4);
    And(a=sel00, b=a[5], out=outa5);
    And(a=sel00, b=a[6], out=outa6);
    And(a=sel00, b=a[7], out=outa7);
    And(a=sel00, b=a[8], out=outa8);
    And(a=sel00, b=a[9], out=outa9);
    And(a=sel00, b=a[10], out=outa10);
    And(a=sel00, b=a[11], out=outa11);
    And(a=sel00, b=a[12], out=outa12);
    And(a=sel00, b=a[13], out=outa13);
    And(a=sel00, b=a[14], out=outa14);
    And(a=sel00, b=a[15], out=outa15);

    // b
    And(a=sel01, b=b[0], out=outb0);
    And(a=sel01, b=b[1], out=outb1);
    And(a=sel01, b=b[2], out=outb2);
    And(a=sel01, b=b[3], out=outb3);
    And(a=sel01, b=b[4], out=outb4);
    And(a=sel01, b=b[5], out=outb5);
    And(a=sel01, b=b[6], out=outb6);
    And(a=sel01, b=b[7], out=outb7);
    And(a=sel01, b=b[8], out=outb8);
    And(a=sel01, b=b[9], out=outb9);
    And(a=sel01, b=b[10], out=outb10);
    And(a=sel01, b=b[11], out=outb11);
    And(a=sel01, b=b[12], out=outb12);
    And(a=sel01, b=b[13], out=outb13);
    And(a=sel01, b=b[14], out=outb14);
    And(a=sel01, b=b[15], out=outb15);


    // c
    And(a=sel10, b=c[0], out=outc0);
    And(a=sel10, b=c[1], out=outc1);
    And(a=sel10, b=c[2], out=outc2);
    And(a=sel10, b=c[3], out=outc3);
    And(a=sel10, b=c[4], out=outc4);
    And(a=sel10, b=c[5], out=outc5);
    And(a=sel10, b=c[6], out=outc6);
    And(a=sel10, b=c[7], out=outc7);
    And(a=sel10, b=c[8], out=outc8);
    And(a=sel10, b=c[9], out=outc9);
    And(a=sel10, b=c[10], out=outc10);
    And(a=sel10, b=c[11], out=outc11);
    And(a=sel10, b=c[12], out=outc12);
    And(a=sel10, b=c[13], out=outc13);
    And(a=sel10, b=c[14], out=outc14);
    And(a=sel10, b=c[15], out=outc15);


    // d
    And(a=sel11, b=d[0], out=outd0);
    And(a=sel11, b=d[1], out=outd1);
    And(a=sel11, b=d[2], out=outd2);
    And(a=sel11, b=d[3], out=outd3);
    And(a=sel11, b=d[4], out=outd4);
    And(a=sel11, b=d[5], out=outd5);
    And(a=sel11, b=d[6], out=outd6);
    And(a=sel11, b=d[7], out=outd7);
    And(a=sel11, b=d[8], out=outd8);
    And(a=sel11, b=d[9], out=outd9);
    And(a=sel11, b=d[10], out=outd10);
    And(a=sel11, b=d[11], out=outd11);
    And(a=sel11, b=d[12], out=outd12);
    And(a=sel11, b=d[13], out=outd13);
    And(a=sel11, b=d[14], out=outd14);
    And(a=sel11, b=d[15], out=outd15);

    // compare
    Or(a=outa0, b=outb0, out=oroutab0);
    Or(a=oroutab0, b=outc0, out=oroutabc0);
    Or(a=oroutabc0, b=outd0, out=out[0]);

    Or(a=outa1, b=outb1, out=oroutab1);
    Or(a=oroutab1, b=outc1, out=oroutabc1);
    Or(a=oroutabc1, b=outd1, out=out[1]);

    Or(a=outa2, b=outb2, out=oroutab2);
    Or(a=oroutab2, b=outc2, out=oroutabc2);
    Or(a=oroutabc2, b=outd2, out=out[2]);

    Or(a=outa3, b=outb3, out=oroutab3);
    Or(a=oroutab3, b=outc3, out=oroutabc3);
    Or(a=oroutabc3, b=outd3, out=out[3]);

    Or(a=outa4, b=outb4, out=oroutab4);
    Or(a=oroutab4, b=outc4, out=oroutabc4);
    Or(a=oroutabc4, b=outd0, out=out[4]);
    
    Or(a=outa5, b=outb5, out=oroutab5);
    Or(a=oroutab5, b=outc5, out=oroutabc5);
    Or(a=oroutabc5, b=outd5, out=out[5]);

    Or(a=outa6, b=outb6, out=oroutab6);
    Or(a=oroutab6, b=outc6, out=oroutabc6);
    Or(a=oroutabc6, b=outd6, out=out[6]);

    Or(a=outa7, b=outb7, out=oroutab7);
    Or(a=oroutab7, b=outc7, out=oroutabc7);
    Or(a=oroutabc7, b=outd7, out=out[7]);

    Or(a=outa8, b=outb8, out=oroutab8);
    Or(a=oroutab8, b=outc8, out=oroutabc8);
    Or(a=oroutabc8, b=outd8, out=out[8]);

    Or(a=outa9, b=outb9, out=oroutab9);
    Or(a=oroutab9, b=outc9, out=oroutabc9);
    Or(a=oroutabc9, b=outd9, out=out[9]);

    Or(a=outa10, b=outb10, out=oroutab10);
    Or(a=oroutab10, b=outc10, out=oroutabc10);
    Or(a=oroutabc10, b=outd10, out=out[10]);

    Or(a=outa11, b=outb11, out=oroutab11);
    Or(a=oroutab11, b=outc11, out=oroutabc11);
    Or(a=oroutabc11, b=outd11, out=out[11]);

    Or(a=outa12, b=outb12, out=oroutab12);
    Or(a=oroutab12, b=outc12, out=oroutabc12);
    Or(a=oroutabc12, b=outd12, out=out[12]);

    Or(a=outa13, b=outb13, out=oroutab13);
    Or(a=oroutab13, b=outc13, out=oroutabc13);
    Or(a=oroutabc13, b=outd13, out=out[13]);

    Or(a=outa14, b=outb14, out=oroutab14);
    Or(a=oroutab14, b=outc14, out=oroutabc14);
    Or(a=oroutabc14, b=outd14, out=out[14]);

    Or(a=outa15, b=outb15, out=oroutab15);
    Or(a=oroutab15, b=outc15, out=oroutabc15);
    Or(a=oroutabc15, b=outd15, out=out[15]);
}