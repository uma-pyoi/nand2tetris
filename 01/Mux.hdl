// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // default out 0, check if need to change 1
    Not(in=sel, out=nsel);
    And(a=nsel, b=a, out=outa); // out 1 iff sel=0, a=1
    And(a=sel, b=b, out=outb); // out 1 iff sel=1, b=1
    Or(a=outa, b=outb, out=out);
}